{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.datomic/local {:mvn/version "1.0.291"}
        ring/ring-core {:mvn/version "1.15.5"}
        ring/ring-jetty-adapter {:mvn/version "1.15.5"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        com.cognitect.aws/api {:mvn/version "0.8.692"}
        com.cognitect.aws/endpoints {:mvn/version "1.1.12.626"}
        com.cognitect.aws/ec2 {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/iam {:mvn/version "848.2.1413.0"}}
 :aliases {:test {:extra-paths ["test"]
                   :extra-deps {infratomic/dev-local-gateway {:local/root "../dev-local-gateway"}}
                   :exec-fn    infratomic.state-backend.test-runner/run-tests}
           :integration-test {:extra-paths ["test"]
                               :extra-deps {infratomic/dev-local-gateway {:local/root "../dev-local-gateway"}}
                               :exec-fn    infratomic.state-backend.test-runner/run-integration-tests}
           :build {:deps      {io.github.clojure/tools.build
                                {:git/tag "v0.10.5" :git/sha "2a21b7a"}}
                   :ns-default build}}}
